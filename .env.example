# ---------------------------------------------------------------------------
# Careful2 environment. Copy to `.env` and adjust. docker-compose reads this.
# ---------------------------------------------------------------------------

# --- Postgres (used by both the db container and the app) ---
POSTGRES_USER=careful2
POSTGRES_PASSWORD=careful2_dev_password
POSTGRES_DB=careful2

# Connection string the app uses. Host `db` is the compose service name.
DATABASE_URL=postgres://careful2:careful2_dev_password@db:5432/careful2

# --- App server ---
PORT=3001
NODE_ENV=production

# --- Default admin, seeded on first boot (change these!) ---
ADMIN_EMAIL=admin@careful2.ca
ADMIN_PASSWORD=changeme123
ADMIN_NAME=Careful2 Admin

# --- Distance / geocoding provider ---
# Get a free key (no credit card) at https://openrouteservice.org/dev/#/signup
# Leave blank to run without it: customers then enter distance manually.
ORS_API_KEY=your_ors_api_key_here
DISTANCE_PROVIDER=ors

# --- Pricing (CAD) ---
PRICE_BASE=5.00
PRICE_PER_KM=1.50
PRICE_MIN=8.00
CURRENCY=CAD

# --- Self-hosted geo services (Ontario-only; see README "Geo services") ---
# Internal docker-network URLs — the app talks to these, nothing external.
NOMINATIM_URL=http://nominatim:8080
OSRM_URL=http://osrm:5000
# Ontario bounding box as minLon,minLat,maxLon,maxLat — bounds autocomplete
# results so they never return addresses outside the province.
ONTARIO_VIEWBOX=-95.2,41.6,-74.3,56.9
# Password for the self-hosted Nominatim container's internal Postgres.
NOMINATIM_PASSWORD=nominatim_dev_password
